# ⛔ No subir variables sensibles
.env
backend/.env
frontend/.env

# ⛔ No subir dependencias de Node
node_modules/
backend/node_modules/
frontend/node_modules/

# ⛔ No subir carpetas de build de React
frontend/build/
public/
!frontend/public/
frontend/public/*
!frontend/public/media/
!frontend/public/media/*.svg

